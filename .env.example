# ==============================================================================
# LeadAI Pro — Environment Configuration Template (.env.example)
# Copy to .env.local for local development. Never commit secrets to git.
# In Vercel, configure these under Project -> Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas, local MongoDB, or Neon Postgres)
MONGODB_URI=
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
JWT_SECRET=

# Public application base URL (e.g. https://leades-generation.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=
AUTH_URL=

# Initial Administrator Seed Account (Auto-seeded if DB is fresh)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@leadai.pro
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. AI & LANGUAGE MODEL (Required for Lead Scoring, Copywriting & Copilot)
# ------------------------------------------------------------------------------
# OpenAI API key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Default optimized model (gpt-4o-mini delivers 95% token savings)
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. LEAD DISCOVERY & ENRICHMENT (Required for Auto-Generate)
# ------------------------------------------------------------------------------
# Google Cloud Console (Places API)
GOOGLE_PLACES_API_KEY=

# Apify Console (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=

# Firecrawl API Key for clean, LLM-ready markdown scraping (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# ------------------------------------------------------------------------------
# 5. EMAIL VERIFICATION & DELIVERABILITY (Required for Verify Leads)
# ------------------------------------------------------------------------------
# Hunter.io API key (https://hunter.io/api)
HUNTER_API_KEY=

# ------------------------------------------------------------------------------
# 6. EMAIL OUTREACH DISPATCH (Required for Cold Outreach & Approvals)
# ------------------------------------------------------------------------------
# Primary: Resend API (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=sales@leadai.pro

# Optional Fallback: SMTP Relay
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Physical Postal Address included in outreach footers (UK PECR & CAN-SPAM compliance)
POSTAL_ADDRESS=LeadAI Pro, 71-75 Shelton Street, Covent Garden, London, WC2H 9JQ, UK

# Inbound email webhook secret for reply classification & auto-killswitch
INBOUND_EMAIL_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 7. WHATSAPP BUSINESS CLOUD API (Meta) (Optional)
# ------------------------------------------------------------------------------
# From Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ------------------------------------------------------------------------------
# 8. VERCEL CRON CADENCE SECURITY (Required)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Checked as Authorization: Bearer ${CRON_SECRET} by Vercel Cron
CRON_SECRET=

# ------------------------------------------------------------------------------
# 9. DATA ENCRYPTION & STRIPE BILLING (Optional)
# ------------------------------------------------------------------------------
# 32 random bytes in base64 for field-level encryption
ENCRYPTION_KEY=

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
